# ScriptForge example environment configuration
# Never place real credentials in this file.

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_openai_model

ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=your_claude_model

DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database?sslmode=require

N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-path
N8N_WEBHOOK_TOKEN=your_webhook_secret

MAX_RETRIES=3
REQUEST_TIMEOUT=30
